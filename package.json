{
  "name": "party-games",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && esbuild src/server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/index.js",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "check": "npm run test && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@colyseus/core": "0.18.27",
    "@colyseus/schema": "5.0.45",
    "@colyseus/sdk": "0.18.9",
    "@colyseus/ws-transport": "0.18.4",
    "@fontsource-variable/inter": "5.3.0",
    "@types/qrcode": "^1.5.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "express": "5.3.0",
    "lucide-react": "1.70.0",
    "next-themes": "0.4.6",
    "qrcode": "^1.5.4",
    "rate-limiter-flexible": "11.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "yaml": "2.9.1",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
